{
  "name": "n-plus-one-query-companion",
  "displayName": "N+1 Query Companion",
  "description": "Flags a TypeORM/Sequelize/Drizzle find/query call inside a loop -- the classic N+1 query anti-pattern. No data leaves your editor.",
  "version": "0.1.0",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "orm",    "typeorm",    "sequelize",    "drizzle",    "performance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-n-plus-one-query-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-n-plus-one-query-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
